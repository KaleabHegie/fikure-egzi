# API base URL including the version segment.
# Dev: leave as /api/v1 — Vite proxies /api to the Nest API (see vite.config.ts).
# cPanel: the full API URL, e.g. https://api.fikureegzi.org/api/v1
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=Fikure Egzi Sunday School

# Dev only: where the Vite proxy forwards /api
VITE_DEV_API_PROXY=http://localhost:4100
