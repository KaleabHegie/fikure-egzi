# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4100
# All routes are served under /<API_PREFIX>/v1
API_PREFIX=api
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5180
SWAGGER_ENABLED=true

# ── Database (MySQL / MariaDB) ──────────────────────────────────────────────
# Local dev: `docker compose up -d` in the repo root exposes MariaDB on 3307.
DATABASE_URL=mysql://fikure:fikure_dev_password@localhost:3307/fikure_egzi
DATABASE_POOL_SIZE=10

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# ── Uploads ─────────────────────────────────────────────────────────────────
# Member photos etc. On cPanel keep this OUTSIDE the deployed app folder (or
# back it up) so a redeploy never deletes uploaded files.
UPLOAD_DIR=uploads

# ── Rate limiting (per IP) ─────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# ── Seed (first super admin; used by `npm run db:seed`) ─────────────────────
SEED_ADMIN_EMAIL=admin@fikureegzi.local
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_ADMIN_NAME=System Administrator

# Dev only: password for the demo Mezmur accounts created by `npm run db:seed:demo`
DEMO_USER_PASSWORD=ChangeMe!2026
